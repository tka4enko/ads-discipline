#!/usr/bin/env bash
# Commits and pushes whatever was just written to the state repository.
#
#   ads-save "what was recorded and why"
#   ads-save "..." /path/to/repo        # when not already inside it
#
# Ships with the plugin so the behaviour is the same everywhere a folder is
# connected, instead of depending on whether that particular repository happens
# to provide a script.
#
# Three things it refuses to do quietly, because each has cost real work:
#   - commit nothing and report success
#   - push without pulling, so two machines overwrite each other
#   - leave a failed push looking like a completed save
set -euo pipefail

MSG="${1:-}"
TARGET="${2:-$PWD}"

if [ -z "$MSG" ]; then
  cat >&2 <<'USAGE'
ads-save "what was recorded and why" [path]

A message is required. It is what someone reading the history in three months
uses to decide whether this record still applies — "update" tells them nothing.
USAGE
  exit 2
fi

cd "$TARGET"
if ! ROOT=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "NOT A REPOSITORY: $TARGET" >&2
  echo "Anything written here is not saved and the next session will not find it." >&2
  echo "Connect a working copy of the state repository, or write through the" >&2
  echo "GitHub connector, where the write is the commit." >&2
  exit 1
fi
cd "$ROOT"

if [ -z "$(git status --porcelain)" ]; then
  echo "nothing to save — working copy is clean"
  git pull --rebase -q origin HEAD 2>/dev/null && echo "pulled anything new from the shared history" || true
  exit 0
fi

echo "saving:"
git status --short | sed 's/^/  /'

git add -A
git commit -q -m "$MSG"

if ! git pull --rebase -q origin HEAD 2>/dev/null; then
  echo "CONFLICT merging with the shared history." >&2
  echo "The commit exists but was not pushed. Resolve by hand:" >&2
  echo "  git status  →  git rebase --continue  or  git rebase --abort" >&2
  exit 1
fi

if git push -q origin HEAD 2>/dev/null; then
  echo "saved and pushed: $(git rev-parse --short HEAD)"
else
  echo "committed locally: $(git rev-parse --short HEAD)" >&2
  echo "PUSH FAILED — this work exists on one disk only until it lands" >&2
  exit 1
fi
